# Configuration d'envoi d'email pour la récupération du mot de passe admin.
#
# EN LOCAL : copiez ce fichier en "email_config.py" et remplissez les valeurs.
# EN PRODUCTION : ne pas copier ce fichier — définissez plutôt les variables
# d'environnement RESEND_API_KEY, RESEND_FROM et ADMIN_RECOVERY_EMAIL dans le
# tableau de bord de l'hébergeur. Le serveur les utilisera automatiquement à
# la place de ce fichier.
#
# Pourquoi Resend (API HTTP) plutôt qu'un envoi SMTP classique (Gmail...) :
# de nombreux hébergeurs (dont Railway) bloquent par défaut les ports SMTP
# sortants (587, 465) pour lutter contre le spam. Une requête HTTPS vers
# l'API de Resend passe toujours, quel que soit l'hébergeur.
#
# Mise en place (2 minutes, gratuit jusqu'à 100 emails/jour) :
#   1. Créez un compte sur resend.com avec l'adresse qui doit RECEVOIR les
#      codes de récupération (ex: la même que ADMIN_RECOVERY_EMAIL ci-dessous).
#   2. Dashboard Resend -> API Keys -> Create API Key -> collez le résultat
#      dans RESEND_API_KEY.
#   3. Sans domaine à vous à vérifier, laissez RESEND_FROM sur la valeur par
#      défaut "onboarding@resend.dev" : elle ne peut envoyer qu'à l'adresse
#      utilisée pour créer le compte Resend, ce qui suffit ici puisque c'est
#      la même adresse que ADMIN_RECOVERY_EMAIL. Si vous vérifiez un jour un
#      domaine sur Resend, vous pourrez émettre depuis une adresse à vous.

RESEND_API_KEY = ""

RESEND_FROM = "onboarding@resend.dev"

# L'adresse qui recevra les codes de récupération pour les comptes admin.
ADMIN_RECOVERY_EMAIL = ""
